<script>
(function(){
  var homeView = document.getElementById('view-home');
  var contactView = document.getElementById('view-contact');
  var navlinks = document.getElementById('navlinks');
  var menuToggle = document.getElementById('menuToggle');

  function closeMenu(){
    navlinks.classList.remove('open');
    menuToggle.setAttribute('aria-expanded','false');
  }

  function showHome(scrollTarget){
    contactView.hidden = true;
    homeView.hidden = false;
    document.title = 'ZNS | ホームページ制作・運用のITカンパニー';
    closeMenu();
    if(scrollTarget){
      requestAnimationFrame(function(){
        var el = document.getElementById(scrollTarget);
        if(el) el.scrollIntoView({behavior:'smooth', block:'start'});
      });
    } else {
      window.scrollTo({top:0, behavior:'auto'});
    }
    history.replaceState(null,'','#home');
  }

  function showContact(){
    homeView.hidden = true;
    contactView.hidden = false;
    document.title = 'お問い合わせ | ZNS';
    closeMenu();
    window.scrollTo({top:0, behavior:'auto'});
    history.replaceState(null,'','#contact');
  }

  document.getElementById('logoBtn').addEventListener('click', function(){ showHome(); });
  document.getElementById('navContact').addEventListener('click', showContact);
  document.getElementById('heroContact').addEventListener('click', showContact);
  document.getElementById('ctaContact').addEventListener('click', showContact);
  document.getElementById('footContact').addEventListener('click', showContact);

  document.querySelectorAll('[data-scroll]').forEach(function(btn){
    btn.addEventListener('click', function(){
      var target = btn.getAttribute('data-scroll');
      if(homeView.hidden){ showHome(target); }
      else {
        closeMenu();
        var el = document.getElementById(target);
        if(el) el.scrollIntoView({behavior:'smooth', block:'start'});
      }
    });
  });

  menuToggle.addEventListener('click', function(){
    var open = navlinks.classList.toggle('open');
    menuToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });

  if(location.hash === '#contact'){ showContact(); }

  /* ---- Contact form validation + mailto submit ---- */
  var form = document.getElementById('contactForm');
  var successBox = document.getElementById('successBox');
  var fields = {
    name: {el:'f-name', validate: function(v){ return v.trim().length > 0; }},
    email: {el:'f-email', validate: function(v){ return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim()); }},
    type: {el:'f-type', validate: function(v){ return v.trim().length > 0; }},
    message: {el:'f-message', validate: function(v){ return v.trim().length > 0; }}
  };

  form.addEventListener('submit', function(e){
    e.preventDefault();
    var data = new FormData(form);
    var valid = true;
    Object.keys(fields).forEach(function(key){
      var cfg = fields[key];
      var value = data.get(key) || '';
      var wrap = document.getElementById(cfg.el);
      if(!cfg.validate(value)){
        wrap.classList.add('invalid');
        valid = false;
      } else {
        wrap.classList.remove('invalid');
      }
    });
    if(!valid){
      successBox.classList.remove('show');
      return;
    }

    var body = [
      'お名前: ' + data.get('name'),
      '会社名: ' + (data.get('company') || '（未入力）'),
      'メールアドレス: ' + data.get('email'),
      '電話番号: ' + (data.get('tel') || '（未入力）'),
      'お問い合わせ種別: ' + data.get('type'),
      '',
      'お問い合わせ内容:',
      data.get('message')
    ].join('\n');

    var mailto = 'mailto:info@zns-corp.example.jp'
      + '?subject=' + encodeURIComponent('【ZNSサイト】お問い合わせ: ' + data.get('type'))
      + '&body=' + encodeURIComponent(body);

    window.location.href = mailto;
    successBox.classList.add('show');
    successBox.scrollIntoView({behavior:'smooth', block:'start'});
    form.reset();
  });

  Object.keys(fields).forEach(function(key){
    var input = form.elements[key];
    if(input){
      input.addEventListener('input', function(){
        document.getElementById(fields[key].el).classList.remove('invalid');
      });
    }
  });

  /* ---- Hero network animation ---- */
  var canvas = document.getElementById('net');
  var ctx = canvas.getContext('2d');
  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var dpr = Math.min(window.devicePixelRatio || 1, 2);
  var nodes = [];
  var W, H, raf;

  function primaryColor(){
    return getComputedStyle(document.documentElement).getPropertyValue('--primary').trim() || '#0059ff';
  }
  function accentColor(){
    return getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || '#00c2ff';
  }

  function resize(){
    var rect = canvas.parentElement.getBoundingClientRect();
    W = rect.width; H = rect.height;
    canvas.width = W * dpr; canvas.height = H * dpr;
    canvas.style.width = W+'px'; canvas.style.height = H+'px';
    ctx.setTransform(dpr,0,0,dpr,0,0);
    var count = Math.max(24, Math.min(70, Math.floor(W*H/16000)));
    nodes = [];
    for(var i=0;i<count;i++){
      nodes.push({
        x: Math.random()*W, y: Math.random()*H,
        vx: (Math.random()-0.5)*0.35, vy: (Math.random()-0.5)*0.35
      });
    }
  }

  function tick(){
    ctx.clearRect(0,0,W,H);
    var pc = primaryColor(), ac = accentColor();
    for(var i=0;i<nodes.length;i++){
      var n = nodes[i];
      n.x += n.vx; n.y += n.vy;
      if(n.x<0||n.x>W) n.vx*=-1;
      if(n.y<0||n.y>H) n.vy*=-1;
    }
    for(var i=0;i<nodes.length;i++){
      for(var j=i+1;j<nodes.length;j++){
        var a=nodes[i], b=nodes[j];
        var dx=a.x-b.x, dy=a.y-b.y;
        var dist = Math.sqrt(dx*dx+dy*dy);
        if(dist < 150){
          ctx.strokeStyle = pc;
          ctx.globalAlpha = (1 - dist/150) * 0.35;
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.moveTo(a.x,a.y); ctx.lineTo(b.x,b.y);
          ctx.stroke();
        }
      }
    }
    ctx.globalAlpha = 0.9;
    for(var i=0;i<nodes.length;i++){
      ctx.fillStyle = i%3===0 ? ac : pc;
      ctx.beginPath();
      ctx.arc(nodes[i].x, nodes[i].y, 1.8, 0, Math.PI*2);
      ctx.fill();
    }
    ctx.globalAlpha = 1;
    raf = requestAnimationFrame(tick);
  }

  resize();
  if(reduceMotion){
    tick(); cancelAnimationFrame(raf);
  } else {
    tick();
  }
  window.addEventListener('resize', function(){
    resize();
  });
})();
</script>
